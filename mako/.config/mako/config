font=FiraCode Nerd Font 11
padding=10
margin=15
border-size=2
border-radius=8
default-timeout=5000
max-visible=3
sort=+time

# --- Default Colors ---
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#313244

# --- Criteria-Specific Styles ---

# Make high-urgency notifications red and sticky
[urgency=high]
border-color=#f38ba8
default-timeout=0

# Make low-urgency notifications blue
[urgency=low]
border-color=#89b4fa
